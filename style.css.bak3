:root {
  --bg: #f5f0e8;
  --bg-card: #ffffff;
  --bg-card-hover: #faf7f2;
  --bg-nav: rgba(245, 240, 232, 0.95);
  --text: #1a1a1a;
  --text-muted: #5a5a5a;
  --text-dim: #8a8a8a;
  --accent: #3a9e8f;
  --accent-soft: rgba(58, 158, 143, 0.12);
  --accent-glow: rgba(58, 158, 143, 0.25);
  --border: rgba(0, 0, 0, 0.08);
  --border-light: rgba(0, 0, 0, 0.12);
  --radius: 16px;
  --radius-sm: 12px;
  --shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  --font-body: 'Cairo', sans-serif;
  --font-quran: 'Amiri', serif;
  --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  color-scheme: light;
}

/* ===== الوضع الداكن (اختياري) ===== */
body.dark-mode {
  --bg: #0a0f14;
  --bg-card: #121a22;
  --bg-card-hover: #182230;
  --bg-nav: rgba(12, 18, 24, 0.92);
  --text: #e8edf2;
  --text-muted: #8a9aa8;
  --text-dim: #5a6a78;
  --accent-soft: rgba(58, 158, 143, 0.15);
  --border: rgba(255, 255, 255, 0.06);
  --border-light: rgba(255, 255, 255, 0.1);
  --shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  color-scheme: dark;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  min-height: 100dvh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

.splash {
  position: fixed; inset: 0; z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg);
  transition: opacity 0.7s ease, visibility 0.7s ease;
}
.splash.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.splash-inner { text-align: center; animation: splashFadeIn 1s ease both; }
@keyframes splashFadeIn {
  from { opacity: 0; transform: translateY(20px) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.splash-icon {
  width: 64px; height: 64px; color: var(--accent); margin-bottom: 20px;
  animation: pulseGlow 2.5s ease-in-out infinite;
}
@keyframes pulseGlow {
  0%, 100% { filter: drop-shadow(0 0 6px var(--accent-glow)); }
  50%      { filter: drop-shadow(0 0 18px var(--accent-glow)); }
}
.splash-title {
  font-family: var(--font-quran); font-size: 2.6rem; font-weight: 700;
  letter-spacing: 2px; color: var(--text); margin-bottom: 6px;
}
.splash-sub { font-size: 0.95rem; color: var(--text-muted); letter-spacing: 4px; }

.app-header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(245, 240, 232, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  transition: background var(--transition);
}
.header-inner {
  max-width: 720px; margin: 0 auto; padding: 14px 20px;
  display: flex; align-items: center; justify-content: space-between;
}
.header-brand { display: flex; align-items: center; gap: 10px; }
.brand-icon { width: 30px; height: 30px; color: var(--accent); }
.brand-text { font-family: var(--font-quran); font-size: 1.35rem; font-weight: 700; letter-spacing: 1px; }

.notif-toggle {
  position: relative; width: 42px; height: 42px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: var(--accent-soft); color: var(--accent);
  transition: background var(--transition), transform 0.2s ease;
}
.notif-toggle:hover { background: rgba(58, 158, 143, 0.2); }
.notif-toggle:active { transform: scale(0.92); }
.notif-toggle svg { width: 20px; height: 20px; }
.notif-dot {
  position: absolute; top: 10px; right: 10px; width: 8px; height: 8px;
  border-radius: 50%; background: #e05a5a; border: 2px solid var(--bg); display: none;
}
.notif-dot.visible { display: block; }

.app-main {
  max-width: 720px; margin: 0 auto; padding: 20px 16px 120px;
  position: relative; min-height: calc(100vh - 160px);
}
.page { display: none; animation: pageEnter 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
.page.active { display: block; }
@keyframes pageEnter {
  from { opacity: 0; transform: translateY(18px) scale(0.985); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.page-head { margin-bottom: 24px; padding: 0 4px; }
.page-title { font-family: var(--font-quran); font-size: 1.7rem; font-weight: 700; margin-bottom: 6px; letter-spacing: 0.5px; }
.page-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.7; }

.zikr-list { display: flex; flex-direction: column; gap: 14px; }
.zikr-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 20px;
  transition: background var(--transition), border-color var(--transition), transform 0.25s ease;
  position: relative; overflow: hidden;
}
.zikr-card::before {
  content: ''; position: absolute; top: 0; right: 0; width: 3px; height: 0;
  background: var(--accent); border-radius: 0 0 3px 0; transition: height 0.4s ease;
}
.zikr-card:hover { background: var(--bg-card-hover); border-color: var(--border-light); transform: translateY(-2px); }
.zikr-card:hover::before { height: 100%; }
.zikr-text {
  font-family: var(--font-quran); font-size: 1.25rem; line-height: 2.2;
  color: var(--text); margin-bottom: 14px; word-spacing: 2px;
}
.zikr-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.zikr-source { font-size: 0.72rem; color: var(--text-dim); line-height: 1.6; flex: 1; }
.zikr-count {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 0.75rem; font-weight: 600; color: var(--accent);
  background: var(--accent-soft); padding: 6px 14px; border-radius: 20px;
  white-space: nowrap; cursor: pointer;
  transition: background 0.2s ease, transform 0.15s ease;
  user-select: none; -webkit-tap-highlight-color: transparent;
}
.zikr-count:active { transform: scale(0.94); }
.zikr-count.done { background: rgba(58, 158, 143, 0.35); color: #fff; }
.zikr-count svg { width: 14px; height: 14px; }

.listen-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
.audio-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px 20px;
  display: flex; align-items: center; gap: 16px;
  transition: background var(--transition), border-color var(--transition), transform 0.25s ease;
}
.audio-card:hover { background: var(--bg-card-hover); border-color: var(--border-light); }
.audio-play {
  width: 48px; height: 48px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: var(--accent-soft); color: var(--accent);
  transition: background 0.2s ease, transform 0.15s ease;
}
.audio-play:active { transform: scale(0.9); }
.audio-play svg { width: 20px; height: 20px; }
.audio-play.playing { background: var(--accent); color: #fff; }
.audio-info { flex: 1; min-width: 0; }
.audio-title { font-family: var(--font-quran); font-size: 1.1rem; font-weight: 700; margin-bottom: 4px; }
.audio-sub { font-size: 0.78rem; color: var(--text-muted); }
.audio-progress { width: 100%; height: 3px; background: var(--border); border-radius: 3px; margin-top: 10px; overflow: hidden; }
.audio-progress-bar { height: 100%; width: 0%; background: var(--accent); border-radius: 3px; transition: width 0.3s linear; }

.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;
  background: var(--bg-nav);
  backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border-top: 1px solid var(--border);
  display: flex; justify-content: space-around; align-items: center;
  padding: 8px 4px calc(8px + env(safe-area-inset-bottom));
  max-width: 100%;
}
.nav-btn {
  display: flex; flex-direction: column; align-items: center; gap: 3px;
  padding: 6px 8px; border-radius: var(--radius-sm); color: var(--text-dim);
  transition: color 0.25s ease, background 0.25s ease;
  -webkit-tap-highlight-color: transparent; flex: 1; max-width: 72px;
}
.nav-btn:hover { color: var(--text-muted); }
.nav-btn.active { color: var(--accent); background: var(--accent-soft); }
.nav-icon { display: flex; align-items: center; justify-content: center; }
.nav-icon svg { width: 22px; height: 22px; }
.nav-label { font-size: 0.65rem; font-weight: 600; letter-spacing: 0.3px; }

@media (min-width: 600px) {
  .listen-grid { grid-template-columns: 1fr 1fr; }
  .zikr-text { font-size: 1.35rem; }
  .page-title { font-size: 2rem; }
}
@media (max-width: 380px) {
  .zikr-text { font-size: 1.1rem; }
  .nav-label { font-size: 0.58rem; }
  .nav-icon svg { width: 20px; height: 20px; }
}

/* ===== تحسينات مشغل الصوت ===== */
.audio-progress {
  position: relative;
  width: 100%;
  height: 20px;
  margin-top: 4px;
  cursor: pointer;
  background: transparent;
  border-radius: 0;
  overflow: visible;
}
.audio-progress::before {
  content: '';
  position: absolute;
  left: 0; right: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 3px;
  background: var(--border);
  border-radius: 3px;
}
.audio-progress-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 3px;
  width: 0%;
  background: var(--accent);
  border-radius: 3px;
  transition: width 0.2s linear;
}
.audio-times {
  display: flex;
  justify-content: space-between;
  font-size: 0.68rem;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  margin-top: 2px;
}
.audio-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}
.audio-speed {
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 3px 10px;
  border-radius: 12px;
  min-width: 44px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  transition: background 0.2s;
}
.audio-speed:hover { background: rgba(58, 158, 143, 0.22); }
.audio-vol-icon { display: flex; color: var(--text-muted); }
.audio-vol-icon svg { width: 16px; height: 16px; }
.audio-volume {
  -webkit-appearance: none;
  appearance: none;
  flex: 1;
  height: 3px;
  border-radius: 3px;
  background: var(--border);
  outline: none;
  cursor: pointer;
}
.audio-volume::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: var(--accent);
  cursor: pointer;
  border: none;
}
.audio-volume::-moz-range-thumb {
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: var(--accent);
  border: none;
  cursor: pointer;
}

/* ===== الوضع الداكن — override الهيدر ===== */
body.dark-mode .app-header { background: rgba(10, 15, 20, 0.85); }

/* ===== التاريخ الهجري ===== */
.hijri-date {
  font-size: 0.68rem;
  color: var(--text-muted);
  margin-right: 8px;
  padding-right: 8px;
  border-right: 1px solid var(--border);
  white-space: nowrap;
}

.header-actions { display: flex; align-items: center; gap: 6px; }

.theme-toggle {
  width: 38px; height: 38px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  transition: background 0.2s, transform 0.15s;
}
.theme-toggle:active { transform: scale(0.9); }
.theme-toggle svg { width: 18px; height: 18px; }

/* ===== مؤشر التقدم ===== */
.daily-progress {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
  font-size: 0.78rem;
  color: var(--text-muted);
}
.progress-ring {
  width: 42px; height: 42px;
  transform: rotate(-90deg);
  flex-shrink: 0;
}
.progress-ring circle { fill: none; stroke-width: 4; }
.progress-ring .bg { stroke: var(--border); }
.progress-ring .fg { stroke: var(--accent); stroke-linecap: round; transition: stroke-dashoffset 0.4s ease; }
.progress-text { font-weight: 600; color: var(--text); }

/* ===== مواقيت الصلاة ===== */
.countdown-card {
  background: linear-gradient(135deg, rgba(58,158,143,0.15), rgba(58,158,143,0.05));
  border: 1px solid var(--border-light);
  border-radius: var(--radius);
  padding: 28px 20px;
  text-align: center;
  margin-bottom: 20px;
}
.countdown-label { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 4px; }
.countdown-prayer { font-family: var(--font-quran); font-size: 1.8rem; font-weight: 700; color: var(--accent); margin-bottom: 8px; }
.countdown-timer { font-size: 2.4rem; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 1px; margin-bottom: 4px; }
.countdown-time { font-size: 0.82rem; color: var(--text-muted); }

.prayer-times-grid {
  display: flex; flex-direction: column; gap: 10px;
}
.prayer-time-row {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 18px;
  transition: background 0.2s, border-color 0.2s;
}
.prayer-time-row.current {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.prayer-time-name { font-family: var(--font-quran); font-size: 1.1rem; font-weight: 700; }
.prayer-time-value { font-size: 0.9rem; font-weight: 600; color: var(--accent); font-variant-numeric: tabular-nums; }
.prayer-time-row.current .prayer-time-name { color: var(--accent); }

/* ===== أسماء الله الحسنى ===== */
.names-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}
.name-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 16px 18px;
  transition: background 0.2s, border-color 0.2s;
}
.name-card:hover { background: var(--bg-card-hover); border-color: var(--border-light); }
.name-card .name-ar {
  font-family: var(--font-quran);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 4px;
}
.name-card .name-meaning { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }

/* ===== حديث اليوم ===== */
.hadith-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px 20px;
}
.hadith-text {
  font-family: var(--font-quran);
  font-size: 1.2rem;
  line-height: 2.1;
  margin-bottom: 16px;
}
.hadith-source {
  font-size: 0.78rem;
  color: var(--text-dim);
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

/* ===== أزرار النسخ والمشاركة ===== */
.zikr-actions {
  display: flex;
  gap: 8px;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}
.zikr-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-card-hover);
  padding: 6px 12px;
  border-radius: 16px;
  transition: background 0.2s, color 0.2s;
}
.zikr-action-btn:active { transform: scale(0.95); }
.zikr-action-btn svg { width: 14px; height: 14px; }
.zikr-action-btn:hover { color: var(--accent); background: var(--accent-soft); }

.share-toast {
  position: fixed;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--accent);
  color: #fff;
  padding: 10px 22px;
  border-radius: 24px;
  font-size: 0.82rem;
  font-weight: 600;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s, transform 0.3s;
  z-index: 999;
}
.share-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ===== تحميل الأصوات ===== */
.download-section {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
}
.download-all-btn {
  width: 100%;
  padding: 14px;
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius-sm);
  font-weight: 700;
  font-size: 0.9rem;
  transition: opacity 0.2s, transform 0.15s;
}
.download-all-btn:active { transform: scale(0.98); }
.download-all-btn:disabled { opacity: 0.6; }
.download-status {
  margin-top: 10px;
  font-size: 0.75rem;
  color: var(--text-muted);
  text-align: center;
  min-height: 18px;
}
