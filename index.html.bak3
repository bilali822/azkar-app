<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#0d1b2a">
  <title>أذكار — ذكر وطمأنينة</title>
  <link rel="stylesheet" href="style.css">
  <link rel="manifest" href="manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>

  <div id="splash" class="splash">
    <div class="splash-inner">
      <svg class="splash-icon" viewBox="0 0 48 48" fill="none">
        <path d="M24 4C13 4 4 13 4 24s9 20 20 20 20-9 20-20S35 4 24 4z" stroke="currentColor" stroke-width="2"/>
        <path d="M24 14v12l8 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <h1 class="splash-title">أذكار</h1>
      <p class="splash-sub">ذكرٌ وطمأنينة</p>
    </div>
  </div>

  <header class="app-header" id="appHeader">
    <div class="header-inner">
      <div class="header-brand">
        <svg class="brand-icon" viewBox="0 0 32 32" fill="none">
          <circle cx="16" cy="16" r="13" stroke="currentColor" stroke-width="1.5"/>
          <path d="M16 7v9l6 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="brand-text">أذكار</span>
        <span class="hijri-date" id="hijriDate"></span>
      </div>
      <div class="header-actions">
        <button class="theme-toggle" id="themeToggle" aria-label="تبديل الوضع النهاري">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
        </button>
        <button class="notif-toggle" id="notifToggle" aria-label="تفعيل الإشعارات">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <span class="notif-dot" id="notifDot"></span>
        </button>
      </div>
    </div>
  </header>

  <main class="app-main" id="appMain">

    <section class="page active" id="page-morning" data-page="morning">
      <div class="page-head">
        <h2 class="page-title">أذكار الصباح</h2>
        <p class="page-desc">تُقال بعد صلاة الفجر حتى طلوع الشمس</p>
        <div class="daily-progress" id="morningProgress"></div>
      </div>
      <div class="zikr-list" id="morningList"></div>
    </section>

    <section class="page" id="page-evening" data-page="evening">
      <div class="page-head">
        <h2 class="page-title">أذكار المساء</h2>
        <p class="page-desc">تُقال بعد صلاة العصر حتى غروب الشمس</p>
        <div class="daily-progress" id="eveningProgress"></div>
      </div>
      <div class="zikr-list" id="eveningList"></div>
    </section>

    <section class="page" id="page-prayer-times" data-page="prayer-times">
      <div class="page-head">
        <h2 class="page-title">مواقيت الصلاة</h2>
        <p class="page-desc">أوقات الصلاة حسب موقعك الحالي</p>
      </div>
      <div class="countdown-card" id="countdownCard">
        <div class="countdown-label">الصلاة القادمة</div>
        <div class="countdown-prayer" id="nextPrayerName">—</div>
        <div class="countdown-timer" id="countdownTimer">—:—:—</div>
        <div class="countdown-time" id="nextPrayerTime"></div>
      </div>
      <div class="prayer-times-grid" id="prayerTimesGrid"></div>
    </section>

    <section class="page" id="page-listen" data-page="listen">
      <div class="page-head">
        <h2 class="page-title">استمع</h2>
        <p class="page-desc">تلاوات وأصوات مباركة</p>
      </div>
      <div class="listen-grid" id="listenGrid"></div>
      <div class="download-section">
        <button class="download-all-btn" id="downloadAllBtn">تحميل جميع الأصوات للاستخدام دون إنترنت</button>
        <div class="download-status" id="downloadStatus"></div>
      </div>
    </section>

    <section class="page" id="page-sleep" data-page="sleep">
      <div class="page-head">
        <h2 class="page-title">أذكار النوم</h2>
        <p class="page-desc">ما يُقال عند إرادة النوم كما ورد في السنة</p>
      </div>
      <div class="zikr-list" id="sleepList"></div>
    </section>

    <section class="page" id="page-prayer" data-page="prayer">
      <div class="page-head">
        <h2 class="page-title">أذكار ما بعد الصلاة</h2>
        <p class="page-desc">الأذكار الواردة بعد السلام من الصلاة المكتوبة</p>
      </div>
      <div class="zikr-list" id="prayerList"></div>
    </section>

    <section class="page" id="page-names" data-page="names">
      <div class="page-head">
        <h2 class="page-title">أسماء الله الحسنى</h2>
        <p class="page-desc">99 اسمًا مع معانيها</p>
      </div>
      <div class="names-grid" id="namesGrid"></div>
    </section>

    <section class="page" id="page-hadith" data-page="hadith">
      <div class="page-head">
        <h2 class="page-title">حديث اليوم</h2>
        <p class="page-desc">حديث قصير يتغير يوميًا من الصحيحين</p>
      </div>
      <div class="hadith-card" id="hadithCard"></div>
    </section>

  </main>

  <nav class="bottom-nav" id="bottomNav">
    <button class="nav-btn active" data-target="morning">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span>
      <span class="nav-label">الصباح</span>
    </button>
    <button class="nav-btn" data-target="evening">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></span>
      <span class="nav-label">المساء</span>
    </button>
    <button class="nav-btn" data-target="prayer-times">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
      <span class="nav-label">المواقيت</span>
    </button>
    <button class="nav-btn" data-target="listen">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></span>
      <span class="nav-label">استمع</span>
    </button>
    <button class="nav-btn" data-target="sleep">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/><path d="M17 4l3 3-3 3"/></svg></span>
      <span class="nav-label">النوم</span>
    </button>
    <button class="nav-btn" data-target="prayer">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20h16M6 20V10l6-6 6 6v10"/></svg></span>
      <span class="nav-label">الصلاة</span>
    </button>
    <button class="nav-btn" data-target="names">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
      <span class="nav-label">الأسماء</span>
    </button>
    <button class="nav-btn" data-target="hadith">
      <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
      <span class="nav-label">حديث</span>
    </button>
  </nav>

  <div class="share-toast" id="shareToast"></div>
  <canvas id="shareCanvas" style="display:none;"></canvas>

  <script src="https://cdn.jsdelivr.net/npm/adhan@4.4.3/dist/adhan.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="app.js"></script>
</body>
</html>
